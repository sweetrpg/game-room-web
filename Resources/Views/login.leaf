#extend("base"):
#export("content"):

<h1>#(title)</h1>

#if(loginError):
<div class="alert alert-danger" role="alert">
    User authentication error: #(loginError)
</div>
#endif

<a href="/auth/login">
    <img class="mt-3" src="/images/sign-in-with-auth0.png"
         alt="Sign In With Auth0">
</a>

<br />

#endexport
#endextend
