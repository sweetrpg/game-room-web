#extend("base"):
#export("content"):
<img src="/images/logo.png"
     class="mx-auto d-block" alt="TIL Logo" />

<h1>Publishers</h1>

<table>
    <thead>
    <tr>
        <th>Publisher</th>
    </tr>
    </thead>
    <tbody>
    #for(publisher in publishers)
    <tr>
        <td>#(publisher.name)</td>
    </tr>
    #endfor
    </tbody>
</table>

#endexport
#endextend
